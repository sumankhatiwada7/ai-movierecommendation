// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum userrole {
  user
  admin
}
enum subscriptionstatus {

  active
  expired
  cancled
  past_due
}
enum paymentstatus{
   pending
   completed
   canceled
   refunded
}

model user {
  id    String @id @default(cuid())
  name String
  email String @unique
  password String 
  role userrole @default(user)
  refreshtoken String 
  watchhistory watchhistory[]
  watchlist watchlist[]
  subscriptions subscription[]
  payments       payment[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

}

model watchhistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  tmdbId    Int      @map("tmdb_id")
  watchedAt DateTime @default(now()) @map("watched_at")
  @@unique([userId, tmdbId])
  @@index([userId])
  @@map("watch_history")
}
model WatchProgress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tmdbId    Int   @map("tmdb_id") 
  time      Float    
  updatedAt DateTime @default(now()) @map("updated_at")

  @@unique([userId, tmdbId])
  @@map("watch_progress")
}
model watchlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int      @map("tmdb_id")
  title     String? 
  addedAt   DateTime @default(now()) @map("added_at")

  @@unique([userId, tmdbId])
  @@map("watchlist")
}

model plan {
  id           String   @id @default(cuid())
  name         String   @unique
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int      @map("duration_days")

  subscriptions subscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

model subscription {
  id     String @id @default(cuid())
  userId String @map("user_id")
  planId String @map("plan_id")

  status    subscriptionstatus @default(active)
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")

  providerSubscriptionId String? @unique @map("provider_subscription_id")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan plan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([planId])
  @@map("subscriptions")
}
model payment {
  id     String @id @default(cuid())
  userId String @map("user_id")

  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("USD")
  status   paymentstatus @default(pending)

  providerPaymentId String? @unique @map("provider_payment_id")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("payments")
}