// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum userrole {
  user
  admin
}

model user {
  id    String @id @default(cuid())
  name String
  email String @unique
  password String 
  role userrole @default(user)
  refreshtoken String 
  watchhistory watchhistory[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

}
model Genre{
  id   String @id @default(cuid())
  name String @unique
  movie Movie[] @relation("genre_movie")
  @@map("genre")
}
model Movie {
  id              Int             @id @default(autoincrement())
  tmdbId          Int             @unique @map("tmdb_id")
  title           String
  description     String?
  releaseYear     Int?            @map("release_year")
  durationMinutes Int?            @map("duration_minutes")
  posterUrl       String?         @map("poster_url")
  backdropUrl     String?         @map("backdrop_url")
  trailerKey      String?         @map("trailer_key")
  director        String?
  averageRating   Float           @default(0) @map("average_rating")
  ratingCount     Int             @default(0) @map("rating_count")
  genres          Genre[]         @relation("genre_movie")
  watchedBy       watchhistory[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([title])
  @@map("movies")
}

model watchhistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   Int      @map("movie_id")
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now()) @map("watched_at")

  @@unique([userId, movieId])
  @@index([userId])
  @@map("watch_history")
}